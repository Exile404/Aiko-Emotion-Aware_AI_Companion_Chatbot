# Local backup of score caches WITH raw corpus transcripts. Never commit: IEMOCAP needs a
# signed USC licence and MELD transcripts are copyrighted script dialogue. The committed
# caches carry derived scores and n_words only.
paper/.text_backup/

# Frozen-encoder feature caches for the contamination-free baseline (binary, regenerable)
paper/clean_feats/

# Noise-degradation caches: contain ASR transcripts of licensed corpora. Never commit.
paper/noise_cache/
